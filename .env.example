# Copy to .env.local for local development, or set these in Vercel → Project → Settings → Environment Variables.

# Admin panel (/admin) password, and a long random string used to sign admin sessions
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Storage for wishes, guests and the WhatsApp template (required on Vercel).
# Adding Upstash Redis from the Vercel Marketplace sets KV_REST_API_URL / KV_REST_API_TOKEN automatically;
# for a database created directly at upstash.com use UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN instead.
# Leave empty locally to store data as JSON files in data/.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: public address used in link previews (WhatsApp/Instagram), e.g. a custom domain.
# On Vercel the production domain is used automatically when this is empty.
NEXT_PUBLIC_SITE_URL=
